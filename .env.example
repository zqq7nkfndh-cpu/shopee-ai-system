# Local: python -m shopee_workbench serve prompts for a password if unset.
# Production secrets belong in the hosting secret manager (never commit .env).
APP_PASSWORD=
# Alternatively generate a Werkzeug scrypt password hash using getpass.
APP_PASSWORD_HASH=
APP_ENV=production
APP_ORIGIN=https://your-domain.example
DATABASE_PATH=/data/workbench.sqlite3
# Optional. Set only on the server. Basic features work without these.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
